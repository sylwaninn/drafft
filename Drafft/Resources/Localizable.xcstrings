    "drafft needs it to show people near you. While Using the App is enough, and only your area is ever shown." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft braucht ihn, um dir Leute in deiner Nähe zu zeigen. „Beim Verwenden der App“ reicht, und es wird immer nur deine Gegend angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft la necesita para mostrarte gente cerca. Con «Cuando se use la app» basta, y solo se muestra tu zona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft en a besoin pour te montrer les gens autour de toi. « Lorsque l'app est active » suffit, et seul ton secteur est affiché."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft ne ha bisogno per mostrarti le persone vicine. \"Mentre usi l'app\" basta, e viene mostrata solo la tua zona."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft heeft het nodig om mensen in de buurt te tonen. 'Bij gebruik van app' is genoeg, en alleen je buurt wordt ooit getoond."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O drafft precisa dela para te mostrar pessoas perto de ti. Durante a utilização da app é suficiente, e só a tua zona é mostrada."
          }
        }
      }
    },
    "drafft needs your location to show people near you. We show your area, never your address." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft braucht deinen Standort, um dir Leute in deiner Nähe zu zeigen. Wir zeigen deine Gegend, nie deine Adresse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft necesita tu ubicación para mostrarte gente cerca. Mostramos tu zona, nunca tu dirección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft a besoin de ta position pour te montrer les gens autour de toi. On affiche ton secteur, jamais ton adresse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft ha bisogno della tua posizione per mostrarti le persone vicine. Mostriamo la tua zona, mai il tuo indirizzo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft heeft je locatie nodig om mensen in de buurt te tonen. We tonen je buurt, nooit je adres."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O drafft precisa da tua localização para te mostrar pessoas perto de ti. Mostramos a tua zona, nunca a tua morada."
          }
        }
      }
    },
