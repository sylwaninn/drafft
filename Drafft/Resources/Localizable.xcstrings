    "Nobody can see your profile yet, so a boost wouldn't reach anyone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch sieht niemand dein Profil, ein Boost würde also niemanden erreichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie puede ver tu perfil todavía, así que un boost no llegaría a nadie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personne ne voit encore ton profil : un boost ne toucherait personne."
