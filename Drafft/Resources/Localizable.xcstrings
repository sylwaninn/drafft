    "Deleting removes your profile, photos, matches and messages for good. Your matches won't be able to reach you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Löschen werden dein Profil, deine Fotos, Matches und Nachrichten endgültig entfernt. Deine Matches können dich dann nicht mehr erreichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al eliminarla, se borran para siempre tu perfil, tus fotos, tus matches y tus mensajes. Tus matches ya no podrán contactarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression efface définitivement ton profil, tes photos, tes matchs et tes messages. Tes matchs ne pourront plus te contacter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'eliminazione rimuove per sempre profilo, foto, match e messaggi. I tuoi match non potranno più contattarti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijderen wist je profiel, foto's, matches en berichten voorgoed. Je matches kunnen je dan niet meer bereiken."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar a conta apaga para sempre o teu perfil, fotos, matches e mensagens. Os teus matches deixam de te poder contactar."
          }
        }
      }
    },
