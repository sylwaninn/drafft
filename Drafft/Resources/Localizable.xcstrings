    "Everyone on drafft verifies a phone number. It keeps fake accounts out." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle auf drafft verifizieren eine Telefonnummer. Das hält Fake-Konten fern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En drafft todo el mundo verifica un número de teléfono. Así evitamos las cuentas falsas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur drafft, tout le monde vérifie son numéro de téléphone. C'est notre rempart contre les faux comptes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su drafft tutti verificano un numero di telefono. Così teniamo fuori gli account falsi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iedereen op drafft verifieert een telefoonnummer. Zo houden we nepaccounts buiten."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
