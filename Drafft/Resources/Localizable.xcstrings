    "Apple emails your receipt. Manage your subscription anytime in You." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple schickt dir die Quittung per E-Mail. Verwalte dein Abo jederzeit unter Du."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple te envía el recibo por email. Gestiona tu suscripción cuando quieras en Tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple t'envoie ton reçu par e-mail. Gère ton abonnement quand tu veux dans Toi."
