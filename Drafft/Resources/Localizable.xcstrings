    "Shown on your profile so nobody's guessing. Skip it to keep it private." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf deinem Profil sichtbar, damit niemand raten muss. Überspring es, um es privat zu halten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra en tu perfil para que nadie tenga que adivinarlo. Omítelo para mantenerlo en privado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiché sur ton profil pour que personne n'ait à deviner. Passe cette étape pour le garder privé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visibile sul tuo profilo, così nessuno deve indovinare. Saltalo per tenerlo privato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zichtbaar op je profiel, zodat niemand hoeft te raden. Sla het over om het privé te houden."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece no teu perfil para ninguém ter de adivinhar. Salta este passo para o manteres privado."
          }
        }
      }
    },
