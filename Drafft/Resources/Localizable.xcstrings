    "Someone from our team will review it, usually within 24 hours. It stays off your profile until then." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemand aus unserem Team prüft es, meist innerhalb von 24 Stunden. Bis dahin erscheint es nicht auf deinem Profil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguien de nuestro equipo la revisará, normalmente en menos de 24 horas. Hasta entonces no aparecerá en tu perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelqu'un de notre équipe va l'examiner, en général sous 24 heures. D'ici là, elle n'apparaît pas sur ton profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una persona del nostro team la esaminerà, di solito entro 24 ore. Fino ad allora resta fuori dal tuo profilo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iemand van ons team bekijkt hem, meestal binnen 24 uur. Tot die tijd staat hij niet op je profiel."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguém da nossa equipa vai analisá-la, normalmente em 24 horas. Até lá, fica fora do teu perfil."
          }
        }
      }
    },
