            "value" : "Mantén pulsado para grabar, suelta para enviar. Desliza a la izquierda para cancelar y hacia arriba para bloquear."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintiens pour enregistrer, relâche pour envoyer. Glisse à gauche pour annuler, vers le haut pour verrouiller."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto per registrare, rilascia per inviare. Scorri a sinistra per annullare, in alto per bloccare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd vast om op te nemen, laat los om te versturen. Schuif naar links om te annuleren, omhoog om vast te zetten."
