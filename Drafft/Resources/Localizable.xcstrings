    "You can close this. We'll switch as soon as you confirm." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst das schließen. Wir stellen um, sobald du bestätigst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cerrar esto. Lo cambiaremos en cuanto lo confirmes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux fermer. On change dès que tu confirmes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi chiudere. Faremo il cambio appena confermi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt dit sluiten. We passen het aan zodra je bevestigt."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podes fechar isto. Mudamos assim que confirmares."
          }
        }
      }
    },
    "You can end a session anytime, no explanation needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst eine Session jederzeit verlassen, ohne Begründung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes irte de una sesión cuando quieras, sin dar explicaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux quitter une séance à tout moment, sans te justifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi lasciare una sessione quando vuoi, senza giustificarti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt een sessie altijd verlaten, zonder uitleg."
