    "You and %@ both do %@. Say hi, or propose a session while it's fresh." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du und %@ macht beide %@. Sag Hallo oder schlag eine Session vor, solange es noch frisch ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ y tú practicáis %@. Saluda o propón una sesión ahora que está reciente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ et toi, vous partagez un sport : %@. Dis bonjour, ou propose une séance tant que c'est frais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu e %@ fate entrambi %@. Saluta o proponi subito una sessione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij en %@ doen allebei %@. Zeg hoi of stel een sessie voor nu het nog vers is."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu e %@ praticam %@. Diz olá ou propõe já uma sessão."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You and %@ both do %@. Say hi, or propose a session while it's fresh."
          }
        }
      }
    },
    "%@ likes you too. Say hi, or propose a session while it's fresh." : {
