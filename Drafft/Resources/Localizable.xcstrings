          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado: as notificações só dizem quem escreveu, não o quê."
          }
        }
      }
    },
    "Offer a few times that work for you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlag ein paar Zeiten vor, die in deine Woche passen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propón unos horarios que encajen en tu semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propose quelques créneaux qui collent à ta semaine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proponi qualche orario che si incastra nella tua settimana."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel een paar tijden voor die in je week passen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propõe uns horários que encaixem na tua semana."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propose a few times that fit your week."
          }
        }
      }
    },
    "Offer up to %lld times. %@ picks one, or suggests others." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlag bis zu %lld Zeiten vor. %@ wählt eine oder schlägt andere vor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propón hasta %lld horarios. %@ elige uno o propone otros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propose jusqu'à %lld créneaux. %@ en choisit un, ou en propose d'autres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proponi fino a %1$lld orari. %2$@ ne sceglie uno o ne propone altri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel tot %lld tijden voor. %@ kiest er één of stelt andere voor."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propõe até %lld horários. %@ escolhe um ou propõe outros."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propose up to %lld times. %@ picks one or proposes others."
          }
        }
      }
    },
