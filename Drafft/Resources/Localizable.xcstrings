    "It shows on your profile as “Training for…”. Big or small, it's a great conversation starter." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es steht auf deinem Profil unter „Trainiert für“. Ob groß oder klein: Andere können dich direkt danach fragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece en tu perfil como «Entrenando para». Grande o pequeño, les da a los demás algo que preguntarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s'affiche sur ton profil sous « Objectif ». Grand ou petit, c'est une question toute trouvée pour les autres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appare sul tuo profilo come “Mi alleno per”. Grande o piccolo, dà agli altri qualcosa da chiederti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het staat op je profiel onder ‘Traint voor’. Groot of klein, zo hebben anderen meteen iets om je te vragen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece no teu perfil como “A treinar para”. Grande ou pequeno, dá aos outros algo para te perguntarem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It shows on your profile under “Training for”. Big or small, it gives people something to ask you about."
          }
        }
      }
    },
