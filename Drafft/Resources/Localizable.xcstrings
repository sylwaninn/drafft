    "Deleting removes them with your profile, photos, matches and messages, for good." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Löschen verschwinden sie mit deinem Profil, deinen Fotos, Matches und Nachrichten, endgültig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al eliminar la cuenta, se borran con tu perfil, tus fotos, tus matches y tus mensajes, para siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression les efface avec ton profil, tes photos, tes matchs et tes messages, définitivement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminando l'account spariscono per sempre, insieme a profilo, foto, match e messaggi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij verwijderen verdwijnen ze voorgoed, samen met je profiel, foto's, matches en berichten."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao eliminar a conta, desaparecem para sempre com o teu perfil, fotos, matches e mensagens."
          }
        }
      }
    },
    "Deleting removes your profile, photos, matches and messages for good. Your matches won't be able to reach you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Profil, deine Fotos, Matches und Nachrichten, endgültig. Deine Matches können dich dann nicht mehr erreichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu perfil, tus fotos, tus matches y tus mensajes, para siempre. Tus matches ya no podrán contactarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton profil, tes photos, tes matchs et tes messages, définitivement. Tes matchs ne pourront plus te contacter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profilo, foto, match e messaggi, per sempre. I tuoi match non potranno più contattarti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je profiel, foto's, matches en berichten, voorgoed. Je matches kunnen je dan niet meer bereiken."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O teu perfil, fotos, matches e mensagens, para sempre. Os teus matches deixam de te poder contactar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your profile, photos, matches and messages, for good. Your matches won't be able to reach you."
          }
        }
      }
    },
    "Deleting your account doesn't cancel drafft tempo. Cancel it in the App Store to stop it renewing." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting your account doesn't cancel drafft tempo. Cancel it in the App Store to stop it renewing."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer ton compte ne résilie pas drafft tempo. Résilie-le dans l'App Store pour qu'il ne se renouvelle plus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar tu cuenta no cancela drafft tempo. Cancélalo en el App Store para que no se renueve."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du dein Konto löschst, wird drafft tempo nicht gekündigt. Kündige es im App Store, damit es sich nicht verlängert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminare l'account non annulla drafft tempo. Annullalo nell'App Store perché non si rinnovi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar a tua conta não cancela o drafft tempo. Cancela-o na App Store para não se renovar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je account verwijderen zegt drafft tempo niet op. Zeg het op in de App Store, anders wordt het verlengd."
          }
        }
      }
    },
