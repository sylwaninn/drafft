    "Off: notifications only say who wrote, not what." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus: Mitteilungen zeigen nur, wer geschrieben hat, nicht was."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado: las notificaciones solo dicen quién te ha escrito, no qué."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé : les notifications disent seulement qui a écrit, pas quoi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato: le notifiche dicono solo chi ha scritto, non cosa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
