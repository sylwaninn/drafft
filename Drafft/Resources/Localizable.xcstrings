    "Offer a few times that work for you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlag ein paar Zeiten vor, die dir passen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propón varias horas que te vengan bien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propose quelques créneaux qui te conviennent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proponi qualche orario che ti va bene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel een paar tijden voor die jou uitkomen."
          }
