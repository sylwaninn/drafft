          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft tempo se renueva hasta que lo canceles. Los boosts y superlikes son compras únicas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft tempo se renouvelle jusqu'à ce que tu résilies. Les boosts et les super likes sont des achats uniques."
