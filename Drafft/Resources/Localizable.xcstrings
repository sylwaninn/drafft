    "It shows on your profile as “Training for…”. Big or small, it's a great conversation starter." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es steht auf deinem Profil als „Trainiert für…“. Ob groß oder klein: ein toller Gesprächseinstieg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece en tu perfil como «Entrenando para…». Grande o pequeño, es un gran tema para empezar a hablar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il apparaît sur ton profil sous la forme « Objectif… ». Grand ou petit, c'est un super sujet de conversation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appare sul tuo profilo come “Mi alleno per…”. Grande o piccolo, è un ottimo spunto per iniziare a parlare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het staat op je profiel als ‘Traint voor…’. Groot of klein, het is een mooie gespreksopener."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece no teu perfil como “A treinar para…”. Grande ou pequeno, é ótimo para começar uma conversa."
          }
        }
      }
    },
    "It's a match." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr habt ein Match."
          }
        },
