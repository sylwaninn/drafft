        }
      }
    },
    "Our team is checking your first photo. Put another one first, or wait." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unser Team prüft dein erstes Foto. Setz ein anderes an den Anfang oder warte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuestro equipo está revisando tu primera foto. Pon otra primero o espera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notre équipe vérifie ta première photo. Mets-en une autre en premier, ou patiente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nostro team sta controllando la tua prima foto. Metti un'altra per prima o aspetta."
