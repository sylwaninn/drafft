    },
    "You can replace your number, not remove it: it keeps your account secure." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst deine Nummer ersetzen, aber nicht entfernen: Sie schützt dein Konto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cambiar tu número, pero no quitarlo: mantiene tu cuenta segura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux remplacer ton numéro, pas le supprimer : il protège ton compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi sostituire il tuo numero, non rimuoverlo: protegge il tuo account."
