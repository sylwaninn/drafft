    "You can't change it later. If it's ever wrong, write to the help center in You." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can't change it later. If it's ever wrong, write to the help center in You."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce choix ne pourra plus être modifié. En cas d'erreur, écris au centre d'aide depuis Toi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No podrás cambiarlo después. Si algún día no es correcto, escribe al centro de ayuda desde Tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das kannst du später nicht mehr ändern. Falls es nicht stimmt, schreib dem Hilfe-Center unter Du."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non potrai cambiarlo in seguito. Se non è corretto, scrivi al centro assistenza da Tu."
