          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple mailt je het betaalbewijs. Beheer je abonnement altijd onder Jij."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
