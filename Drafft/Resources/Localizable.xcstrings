        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propõe uns horários que te deem jeito."
          }
        }
      }
    },
    "Offer up to %lld times. %@ picks one, or suggests others." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlag bis zu %lld Zeiten vor. %@ wählt eine oder schlägt andere vor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propón hasta %lld horas. %@ elige una o propone otras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propose jusqu'à %lld créneaux. %@ en choisit un, ou en propose d'autres."
