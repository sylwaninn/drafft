      }
    },
    "Apple shares a verified email (or a private relay address) and, the first time only, the name you choose. Never a photo, birthday or phone number." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple teilt eine verifizierte E-Mail (oder eine private Weiterleitungsadresse) und, nur beim ersten Mal, den Namen, den du wählst. Nie ein Foto, Geburtsdatum oder eine Telefonnummer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple comparte un email verificado (o una dirección de reenvío privada) y, solo la primera vez, el nombre que elijas. Nunca una foto, tu fecha de nacimiento ni tu número de teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple partage un e-mail vérifié (ou une adresse relais privée) et, la première fois seulement, le nom que tu choisis. Jamais de photo, de date de naissance ni de numéro de téléphone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple condivide un'email verificata (o un indirizzo di inoltro privato) e, solo la prima volta, il nome che scegli. Mai foto, data di nascita o numero di telefono."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple deelt een geverifieerd e-mailadres (of een privé-doorstuuradres) en alleen de eerste keer de naam die je kiest. Nooit een foto, geboortedatum of telefoonnummer."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Apple partilha um email verificado (ou um endereço de reencaminhamento privado) e, só da primeira vez, o nome que escolheres. Nunca uma foto, a data de nascimento ou o número de telemóvel."
          }
        }
