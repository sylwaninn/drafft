    "Pressure or harassment is on them, never on you. Report it, even if you're unsure." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druck oder Belästigung geht auf ihr Konto, nie auf deins. Melde es, auch wenn du unsicher bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La presión o el acoso es culpa suya, nunca tuya. Denúncialo, aunque tengas dudas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pression ou le harcèlement, c'est sa faute, jamais la tienne. Signale-le, même en cas de doute."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressioni o molestie sono colpa loro, mai tua. Segnalale, anche se hai dei dubbi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druk of intimidatie ligt bij hen, nooit bij jou. Meld het, ook als je twijfelt."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressão ou assédio são culpa de quem o faz, nunca tua. Denuncia, mesmo com dúvidas."
          }
        }
      }
    },
