    "Get a copy of everything you've shared on drafft. We'll email you a download link to a file you can keep or open elsewhere." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hol dir eine Kopie von allem, was du auf drafft geteilt hast. Wir schicken dir per E-Mail einen Download-Link zu einer Datei, die du behalten oder woanders öffnen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consigue una copia de todo lo que has compartido en drafft. Te enviaremos por email un enlace para descargar un archivo que puedes guardar o abrir en otro sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reçois une copie de tout ce que tu as partagé sur drafft. On t'enverra par e-mail un lien de téléchargement vers un fichier que tu peux garder ou ouvrir ailleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi una copia di tutto ciò che hai condiviso su drafft. Ti invieremo via email un link per scaricare un file da conservare o aprire altrove."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krijg een kopie van alles wat je op drafft hebt gedeeld. We mailen je een downloadlink naar een bestand dat je kunt bewaren of ergens anders kunt openen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recebe uma cópia de tudo o que partilhaste no drafft. Enviamos-te por email um link para descarregar um ficheiro que podes guardar ou abrir noutro sítio."
          }
        }
      }
    },
