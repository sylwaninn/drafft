    "They see you first, with a red heart on your profile. It doesn't use a daily like." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Person sieht dich zuerst, mit einem roten Herzen auf deinem Profil. Es verbraucht kein Tages-Like."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te ve primero, con un corazón rojo en tu perfil. No gasta un like diario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La personne te voit en premier, avec un cœur rouge sur ton profil. Ça n'utilise pas de like du jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti vede prima degli altri, con un cuore rosso sul tuo profilo. Non consuma un like giornaliero."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze zien jou als eerste, met een rood hartje op je profiel. Het kost geen dagelijkse like."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veem-te primeiro, com um coração vermelho no teu perfil. Não gasta um like diário."
          }
        }
      }
    },
    "They see you first, with a red heart on your profile. Use them when you like: they never expire." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Person sieht dich zuerst, mit einem roten Herzen auf deinem Profil. Nutze sie, wann du willst: Sie verfallen nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te ve primero, con un corazón rojo en tu perfil. Úsalos cuando quieras: no caducan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La personne te voit en premier, avec un cœur rouge sur ton profil. Utilise-les quand tu veux : ils n'expirent jamais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti vede prima degli altri, con un cuore rosso sul tuo profilo. Usali quando vuoi: non scadono mai."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze zien jou als eerste, met een rood hartje op je profiel. Gebruik ze wanneer je wilt: ze verlopen nooit."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veem-te primeiro, com um coração vermelho no teu perfil. Usa-os quando quiseres: nunca expiram."
          }
        }
      }
    },
