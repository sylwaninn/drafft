    "Google shares your name, email and profile picture. Never your birthday, gender or phone number." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google teilt deinen Namen, deine E-Mail und dein Profilbild. Nie dein Geburtsdatum, Geschlecht oder deine Telefonnummer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google comparte tu nombre, tu email y tu foto de perfil. Nunca tu fecha de nacimiento, tu género ni tu número de teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google partage ton nom, ton e-mail et ta photo de profil. Jamais ta date de naissance, ton genre ni ton numéro de téléphone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google condivide nome, email e foto profilo. Mai data di nascita, genere o numero di telefono."
