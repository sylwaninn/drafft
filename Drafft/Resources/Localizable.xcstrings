    "Sessions a week for each sport. Rough is fine." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie oft du trainierst, bestimmt, wen du triffst. Sessions pro Woche je Sport, grob reicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que entrenas marca a quién conoces. Sesiones por semana y deporte, más o menos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta fréquence d'entraînement guide tes rencontres. Séances par semaine et par sport, à peu près."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto ti alleni orienta chi incontri. Sessioni a settimana per sport, più o meno."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe vaak je traint, bepaalt wie je ontmoet. Sessies per week per sport, ongeveer."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O quanto treinas define quem conheces. Sessões por semana em cada desporto, mais ou menos."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How often you train shapes who you meet. Sessions a week per sport, roughly."
          }
        }
      }
    },
