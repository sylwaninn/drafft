    "For a run or a ride, pick a busy route in daylight and keep your phone charged." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für einen Lauf oder eine Radtour: Wähl eine belebte Strecke bei Tageslicht und halt dein Handy geladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para correr o rodar en bici, elige una ruta concurrida, de día, y lleva el móvil cargado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour un footing ou une sortie vélo, choisis un parcours fréquenté, en plein jour, et garde ton téléphone chargé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per una corsa o un giro in bici, scegli un percorso frequentato, di giorno, e tieni il telefono carico."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies voor een run of fietstocht een drukke route bij daglicht en zorg dat je telefoon opgeladen is."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para uma corrida ou um passeio de bicicleta, escolhe um percurso movimentado, de dia, e leva o telemóvel carregado."
          }
        }
      }
    },
