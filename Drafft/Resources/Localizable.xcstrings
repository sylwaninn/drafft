    "They see you first, with a red heart on your profile. It doesn't use a daily like." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du landest ganz oben bei der Person, mit rotem Herz. Das kostet kein Tages-Like."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llegas el primero a su lista, con un corazón rojo. No gasta un like del día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu arrives en tête de sa pile, avec un cœur rouge. Ça n'utilise pas de like du jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrivi in cima al suo mazzo, con un cuore rosso. Non usa un like del giorno."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je komt bovenaan bij die persoon, met een rood hart. Het kost geen like van vandaag."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chegas ao topo da lista dessa pessoa, com um coração vermelho. Não gasta um like do dia."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Land at the top of their deck with a red heart. It doesn't use a daily like."
          }
        }
      }
    },
    "They see you first, with a red heart on your profile. Use them when you like: they never expire." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Person sieht dich zuerst, mit einem roten Herzen auf deinem Profil. Nutze sie, wann du willst: Sie verfallen nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te ve primero, con un corazón rojo en tu perfil. Úsalos cuando quieras: no caducan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La personne te voit en premier, avec un cœur rouge sur ton profil. Utilise-les quand tu veux : ils n'expirent jamais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti vede prima degli altri, con un cuore rosso sul tuo profilo. Usali quando vuoi: non scadono mai."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze zien jou als eerste, met een rood hartje op je profiel. Gebruik ze wanneer je wilt: ze verlopen nooit."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veem-te primeiro, com um coração vermelho no teu perfil. Usa-os quando quiseres: nunca expiram."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each one puts you at the top of their deck with a red heart. Use them when you like: they never expire."
          }
        }
      }
    },
