    "You can block someone from their profile or a chat." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst jemanden über das Profil oder einen Chat blockieren."
          }
        },
        "es" : {
          "stringUnit" : {
