            "value" : "30 Minuten lang stehst du ganz vorne für alle, die in deiner Nähe trainieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante 30 minutos, apareces primero para quien entrena cerca de ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant 30 minutes, tu passes en premier pour qui s'entraîne autour de toi."
          }
        },
        "it" : {
