    "They won't be notified, and you won't see each other again. Reports go to our safety team." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Person wird nicht benachrichtigt, und ihr seht euch nicht wieder. Meldungen gehen an unser Sicherheitsteam."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No recibirá ningún aviso y no volveréis a veros. Las denuncias llegan a nuestro equipo de seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette personne ne sera pas prévenue, et vous ne vous reverrez plus. Les signalements sont transmis à notre équipe sécurité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non riceverà nessuna notifica e non vi vedrete più. Le segnalazioni vanno al nostro team sicurezza."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze krijgen geen melding en jullie zien elkaar niet meer. Meldingen gaan naar ons veiligheidsteam."
