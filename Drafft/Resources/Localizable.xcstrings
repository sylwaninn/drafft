        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt dit later niet meer wijzigen. Klopt het niet, schrijf dan naar het helpcentrum onder Jij."
          }
        }
      }
    },
    "You're hidden from Discover, and discovery waits until you resume. Your chats and sessions carry on." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're hidden from Discover, and discovery waits until you resume. Your chats and sessions carry on."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
