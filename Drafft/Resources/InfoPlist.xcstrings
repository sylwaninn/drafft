    "NSCalendarsFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft hält die Sessions in deinem Kalender aktuell und entfernt sie, wenn sie abgesagt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft keeps the sessions you add to your calendar up to date, and removes them if they're cancelled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft mantiene al día las sesiones que añades a tu calendario y las quita si se cancelan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft met à jour les séances que tu ajoutes à ton calendrier, et les retire si elles sont annulées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft tiene aggiornate le sessioni che aggiungi al calendario e le rimuove se vengono annullate."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft houdt de sessies in je agenda up-to-date en haalt ze weg als ze worden geannuleerd."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O drafft mantém atualizadas as sessões que adicionas ao calendário e remove-as se forem canceladas."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft nutzt die Kamera für Fotos in deinem Profil und deinen Chats und für das Selfie, das bestätigt, dass du es bist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft uses your camera for photos in your profile and chats, and for the selfie that confirms it's you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft usa la cámara para las fotos de tu perfil y tus chats, y para el selfie que confirma que eres tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft utilise l'appareil photo pour les photos de ton profil et de tes discussions, et pour le selfie qui confirme que c'est toi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft usa la fotocamera per le foto del tuo profilo e delle chat, e per il selfie che conferma che sei tu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft gebruikt je camera voor foto's in je profiel en chats, en voor de selfie die bevestigt dat jij het bent."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O drafft usa a câmara para as fotos do teu perfil e das conversas, e para a selfie que confirma que és tu."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft nutzt deinen Standort, um dir Leute in deiner Nähe zu zeigen. Andere sehen deine Gegend und eine gerundete Entfernung, nie deine Adresse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft uses your location to show people near you. Others see your area and a rounded distance, never your address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft usa tu ubicación para mostrarte gente cerca. Los demás ven tu zona y una distancia redondeada, nunca tu dirección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft utilise ta position pour te montrer les personnes autour de toi. Les autres voient ta zone et une distance arrondie, jamais ton adresse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft usa la tua posizione per mostrarti le persone vicine. Gli altri vedono la tua zona e una distanza arrotondata, mai il tuo indirizzo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft gebruikt je locatie om mensen in de buurt te tonen. Anderen zien je buurt en een afgeronde afstand, nooit je adres."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O drafft usa a tua localização para te mostrar pessoas perto de ti. Os outros veem a tua zona e uma distância arredondada, nunca a tua morada."
          }
        }
      }
    },
