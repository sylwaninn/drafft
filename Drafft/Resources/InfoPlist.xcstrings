          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft usa el micrófono para grabar mensajes de voz y tu presentación de voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft utilise le micro pour enregistrer tes messages vocaux et ta présentation vocale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft usa il microfono per registrare i messaggi vocali e la tua presentazione vocale."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drafft gebruikt je microfoon om spraakberichten en je spraakintro op te nemen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O drafft usa o microfone para gravar mensagens de voz e a tua apresentação de voz."
          }
        }
      }
    },
