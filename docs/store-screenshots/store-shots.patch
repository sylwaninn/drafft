+    static func mayaMessages(_ card: SessionProposal) -> [Message] {
+        let base = Calendar.current.date(bySettingHour: 8, minute: 24, second: 0, of: .now)!
+        let lines: [(Bool, String, String)] = [
+            (true, "Your bio says conversation is mandatory until km 25. What happens at 26?", "Ta bio dit conversation obligatoire jusqu'au 25e km. Et au 26e ?"),
+            (false, "Silence. And a gel. Mostly the gel.", "Silence. Et un gel. Surtout le gel."),
+            (true, "Fair. I can do 10 km, tops. Can I have the chatty part?", "Logique. Je tiens 10 km, grand max. Je peux avoir la partie bavarde ?"),
+            (false, "Deal. Easy loop in Vincennes on Saturday? Actually easy, I promise.", "Deal. Boucle tranquille à Vincennes samedi ? Vraiment tranquille, promis."),
+            (true, "Everyone says that.", "C'est ce que tout le monde dit."),
+            (false, "I'll prove it.", "Je vais te le prouver.")
+        ]
+        var out = lines.enumerated().map { i, l in
+            Message(id: "maya-\(i)", .text(t(l.1, l.2)), fromMe: l.0, date: base.addingTimeInterval(Double(i) * 70))
+        }
+        out.append(Message(id: "maya-card", .session(card), fromMe: false, date: base.addingTimeInterval(8 * 60)))
+        return out
+    }
+
+    static func camilleMessages(_ card: SessionProposal) -> [Message] {
+        let base = Date.now.addingTimeInterval(-26 * 3600)
+        let lines: [(Bool, String, String)] = [
+            (true, "Green flag noted. I rack my plates. In order.", "Green flag noté. Je range mes disques. Dans l'ordre."),
+            (false, "Bold claim. Push day Thursday? You spot, I pretend not to mind.", "Audacieux. Haut du corps jeudi ? Tu me pares, je fais semblant que ça ne me vexe pas.")
+        ]
+        var out = lines.enumerated().map { i, l in
+            Message(id: "camille-\(i)", .text(t(l.1, l.2)), fromMe: l.0, date: base.addingTimeInterval(Double(i) * 90))
+        }
+        out.append(Message(id: "camille-card", .session(card), fromMe: false, date: base.addingTimeInterval(5 * 60)))
+        out.append(Message(id: "camille-end", .text(t("See you Thursday.", "À jeudi.")), fromMe: true, date: base.addingTimeInterval(9 * 60)))
+        return out
